<Window x:Class="Konyvek.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Konyvek"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"></ColumnDefinition>
            <ColumnDefinition Width="2*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <StackPanel>
            <Button Content="Könyvek betöltése" Height="30" Margin="5" Click="betoltes"/>
            <Button Content="Hány könyv van?" Height="30" Margin="5" Click="mennyi"/>
            <Button Content="Melyik a leghosszabb könyv?" Height="30" Margin="5" Click="leghosszabbKonyv"/>
            <Button Content="Átlagos oldalszám" Height="30" Margin="5" Click="atlagOldal"/>
            <Button Content="Csak elérhető könyvek" Height="30" Margin="5" Click="elerhetoKonyv"/>
            <Button Content="Csak címek listája" Height="30" Margin="5" Click="csakCimek"/>
            <Button Content="Rendezés szerző szerint" Height="30" Margin="5" Click="rendezes"/>
        </StackPanel>
        <DataGrid x:Name="dgKonyvek" d:ItemsSource="{d:SampleData ItemCount=5}" Grid.Column="1"/>
    </Grid>
</Window>
